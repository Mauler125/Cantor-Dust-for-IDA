# Portable source-contract test: the dock icon is a single embedded SVG.
set(_resources "${CANTORDUST_SOURCE_DIR}/resources")
set(_manifest "${_resources}/cantor_dust.qrc")
set(_svg "${_resources}/cantor_dust.svg")
if(NOT EXISTS "${_svg}" OR NOT EXISTS "${_manifest}")
    message(FATAL_ERROR "The SVG icon and renamed .qrc must exist")
endif()
file(READ "${_manifest}" _qrc)
file(READ "${CANTORDUST_SOURCE_DIR}/src/ida/ida_plugin.cpp" _ida_plugin)
file(READ "${CANTORDUST_SOURCE_DIR}/CMakeLists.txt" _cmake)
if(NOT _qrc MATCHES "<qresource prefix=\"/cantordust\">")
    message(FATAL_ERROR "Unexpected resource prefix")
endif()
if(NOT _qrc MATCHES "<file alias=\"cantor_dust.svg\">cantor_dust.svg</file>")
    message(FATAL_ERROR "SVG icon missing from manifest")
endif()
string(REGEX MATCHALL "<file[ >]" _entries "${_qrc}")
list(LENGTH _entries _entry_count)
if(NOT _entry_count EQUAL 1)
    message(FATAL_ERROR "Expected SVG to be the only icon resource")
endif()
file(GLOB _raster_icons "${_resources}/*.png" "${_resources}/*.ico" "${_resources}/*.jpg")
if(_raster_icons)
    message(FATAL_ERROR "Raster icons are no longer permitted in resources/")
endif()
if(NOT _ida_plugin MATCHES ":/cantordust/cantor_dust.svg")
    message(FATAL_ERROR "Qt icon loader is not using the embedded SVG")
endif()
if(NOT _cmake MATCHES "resources/cantor_dust.qrc")
    message(FATAL_ERROR "CMake AUTORCC is not using resources/cantor_dust.qrc")
endif()
message(STATUS "SVG-only resource contract verified")
